{
  "//": [
    "Example configuration for backend/JevTicketRouter.Api/appsettings.json.",
    "PLACEHOLDERS ONLY. Never put a real API key in this or any committed file.",
    "Supply Jev:ApiKey through .NET User Secrets or the TYPESAFE_API_KEY environment variable."
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },

  "Jev": {
    "//ApiKey": "DO NOT SET HERE. Use: dotnet user-secrets set \"Jev:ApiKey\" \"<your-key>\"",
    "BaseUrl": "https://api.typesafe.ai",
    "EvaluationPath": "/v1/systemone",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "ForceMockMode": false
  },

  "Triage": {
    "Model": "jev-latest",
    "MinimumConfidence": 0.75,
    "SensitiveDataProbabilityThreshold": 0.5,
    "HumanReviewProbabilityThreshold": 0.5
  }
}
