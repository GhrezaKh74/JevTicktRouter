# ---------------------------------------------------------------------------
# JevTicketRouter - example environment file
#
# Copy to .env and fill in real values. NEVER commit the resulting .env:
# it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# Which decision engine runs. One of: Jev | SelfHosted | Local | Mock
#   Jev        - TypeSafe Jev over the public System One API. Used for evaluation.
#   SelfHosted - circuit's open-weights System One models on your own hardware.
#                Same contract as Jev, no key, nothing leaves the machine.
#   Local      - a model inside your own network. The intended production mode
#                for restricted organisational data. Makes no internet calls.
#   Mock       - deterministic sample answers. No model, no network.
#
# An unset or unrecognised value falls back to Mock, and Jev without a key
# falls back to Mock too, so the service always starts.
AI_PROVIDER=Jev

# ---------------------------------------------------------------------------
# Cloud provider (AI_PROVIDER=Jev)
# ---------------------------------------------------------------------------

# Your TypeSafe API key, from https://console.typesafe.ai/settings/keys
# Leave empty to run in Mock mode. Prefer `dotnet user-secrets` locally.
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Self-hosted System One provider (AI_PROVIDER=SelfHosted)
#
# Open-weights models that speak the same /v1/systemone contract as the hosted
# API, so the same client and mapper are reused. Reference implementation:
# https://github.com/Barneyjm/circuit
#
# Docker builds and runs it for you, weights and all:
#
#   AI_PROVIDER=SelfHosted docker compose --profile circuit up --build
#
# Needs circuit's own server: the calibrated probabilities come from a pointer
# readout head that a plain GGUF conversion drops, so Ollama will not do.
# See tools/circuit/README.md.
# ---------------------------------------------------------------------------

# Where the server listens. Under Docker this is http://circuit:8901, which is
# the compose default and needs nothing here.
# SELF_HOSTED_BASE_URL=http://localhost:8901

# Recorded on every decision. Under Docker, CIRCUIT_MODEL below sets both this
# and the weights the server loads, so the two cannot drift apart.
# SELF_HOSTED_MODEL=circuit-1.7b

# circuit wants the bearer header present but ignores the value unless it was
# started with S1_API_KEY. The placeholder keeps the header well-formed.
# SELF_HOSTED_API_KEY=x

# Loading the base model is slow, and the first ticket after a start waits for
# it. Compose raises this to 300 by itself.
# SelfHosted__TimeoutSeconds=120

# ADMINISTRATOR OVERRIDE, as for local mode below: allows a
# SELF_HOSTED_BASE_URL that is not loopback or private.
# SelfHosted__AllowPublicEndpoint=false

# ---------------------------------------------------------------------------
# Local provider (AI_PROVIDER=Local)
# ---------------------------------------------------------------------------

# Base URL of an OpenAI-compatible endpoint, including the version segment.
#   Ollama       http://localhost:11434/v1
#   vLLM         http://localhost:8000/v1
#   llama.cpp    http://localhost:8080/v1
#   LM Studio    http://localhost:1234/v1
#
# Only loopback, RFC 1918 private, link-local, and internal host names are
# accepted. A public address is refused unless the administrator override
# below is switched on, so restricted data cannot leave the network by
# accident.
LOCAL_AI_BASE_URL=http://localhost:11434/v1

# The model to run, e.g. qwen2.5:7b-instruct, llama3.1:8b, mistral-nemo.
LOCAL_AI_MODEL=

# Bearer token, if your endpoint needs one. Ollama does not; vLLM and most
# internal gateways do. Never committed, never sent to the frontend.
LOCAL_AI_API_KEY=

# --- Optional local overrides (defaults shown) ------------------------------
# Local models are slower than a hosted API, so the timeout is generous.
# LocalAi__TimeoutSeconds=120

# Send response_format: json_schema with strict: true. Turn off for a server
# that rejects the field; the reply is validated either way.
# LocalAi__UseStructuredOutputs=true

# Sampling temperature. 0 keeps classification reproducible.
# LocalAi__Temperature=0

# ADMINISTRATOR OVERRIDE. Allows a LOCAL_AI_BASE_URL that is not loopback or
# private. Switch this on only when the address really is an internal gateway
# you control. Off by default, deliberately.
# LocalAi__AllowPublicEndpoint=false

# ---------------------------------------------------------------------------
# Optional backend overrides (defaults shown)
# ---------------------------------------------------------------------------

# Jev model. `jev-latest` tracks the newest stable release; pin a versioned id
# such as jev-1.13.0 to freeze behaviour.
# Triage__Model=jev-latest

# Escalate to a human when confidence falls below this on category, target
# team, or priority.
# Triage__MinimumConfidence=0.75

# Force Mock mode even when a Jev key is present.
# Jev__ForceMockMode=false

# Per-request timeout, in seconds, for the TypeSafe call.
# Jev__TimeoutSeconds=30

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------

# Host port the app is published on. The container always listens on 8080.
# APP_PORT=8080

# Host port for the bundled Ollama service (only with `--profile local`).
# OLLAMA_PORT=11434

# --- Self-hosted circuit (`--profile circuit` or `--profile circuit-stub`) ---

# Which run the server loads, and the name recorded on every decision:
# circuit-1.7b (~3.5 GB, the default) or circuit-8b (~16.6 GB). Accuracy on
# circuit's own validation split is 0.897 against 0.899, hence the default.
# CIRCUIT_MODEL=circuit-1.7b

# Host port the model server is published on. The container always uses 8901.
# CIRCUIT_PORT=8901

# PyTorch wheels to build the circuit image against. The CPU default runs
# anywhere; https://pypi.org/simple gets the CUDA build, for an NVIDIA card.
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Set this AND SELF_HOSTED_API_KEY to the same value to require a real bearer
# token. Empty means any non-empty token is accepted, which is what a server on
# a private network needs.
# CIRCUIT_API_KEY=

# --- When the container cannot download the weights -------------------------

# A resolver for the circuit container. Docker's embedded DNS stops forwarding
# to an upstream surprisingly often -- after a VPN or network change -- and the
# symptom is "Temporary failure in name resolution" on huggingface.co while
# everything works on the host. Unset, Compose leaves the setting out entirely.
# CIRCUIT_DNS=1.1.1.1

# Where the weights are fetched from. Point this at a mirror if huggingface.co
# is unreachable from here. Must never be empty: huggingface_hub reads it as
# os.getenv("HF_ENDPOINT", default), so an empty value replaces the default
# with nothing.
# HF_ENDPOINT=https://huggingface.co

# For a network that only reaches the internet through a proxy.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# A host folder to keep the weights in, instead of a Docker named volume. This
# is how weights downloaded somewhere else get in, on a machine where the
# container itself cannot reach the Hub -- see tools/circuit/README.md.
# CIRCUIT_WEIGHTS=C:/circuit-weights

# Timeout for the local model, in seconds. Local inference is slow to warm up.
# LOCAL_AI_TIMEOUT=180

# ---------------------------------------------------------------------------
# Optional frontend overrides
# ---------------------------------------------------------------------------

# Base URL of the API for a production build. Leave empty in development:
# the Vite dev server proxies /api to the backend.
# VITE_API_BASE_URL=

# Dev-server proxy target, if the backend runs on a non-default port.
# VITE_API_PROXY_TARGET=http://localhost:5217
