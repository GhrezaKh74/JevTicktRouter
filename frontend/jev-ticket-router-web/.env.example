# Base URL of the JevTicketRouter API.
# Leave unset in development: the Vite dev server proxies /api to the backend automatically.
# Set this for a production build, e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Overrides the dev-server proxy target if the backend runs on a non-default port.
VITE_API_PROXY_TARGET=http://localhost:5217
